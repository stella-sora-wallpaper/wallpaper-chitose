{
  "schemaVersion": 1,
  "project": { "id": "stella-sora-chitose", "entry": "src/main.ts" },
  "runtime": { "package": "ba-memorial-lobby-wallpaper-runtime", "range": "^0.5.0" },
  "content": { "studentId": "chitose", "variantId": "base" },
  "resources": {
    "model": { "sourceTier": "live2d", "outputTiers": ["source"] },
    "preview": true,
    "source": {
      "provider": "manual-staging",
      "note": "Do not bundle community-extracted binaries until provenance and redistribution permission are confirmed."
    }
  },
  "structure": {
    "requiredFiles": [
      "src/main.ts",
      "src/config.ts",
      "src/trial/ResourceStagingPanel.ts",
      "vite.config.ts",
      "public/project.json",
      "README.md",
      ".gitignore"
    ],
    "validateHtmlShell": true,
    "validatePreview": true,
    "validateChecksums": false
  },
  "build": { "outputDirectory": "dist", "logRoute": "/__wallpaper-log", "target": "chrome90" },
  "distribution": {
    "requiredFiles": ["index.html", "logging-bootstrap.js", "preview.gif"],
    "previewPath": "preview.gif",
    "previewWidth": 192,
    "previewHeight": 192,
    "previewMaxBytes": 1000000,
    "validatePreview": true
  },
  "package": { "archiveName": "stella-sora-chitose-wallpaper.zip" }
}
